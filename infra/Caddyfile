# Serves the built PWA and reverse-proxies the bridge API on a single origin,
# preserving the same-origin /api/* model the web app expects.
{
	# On a deploy the old containers are stopped one by one before the new ones start,
	# and by default Caddy waits for every open connection to finish. Open apps keep
	# their event stream (/api/events) open for good, so it sat out the whole stop
	# timeout (30 s on Coolify), with the music sources already down meanwhile.
	grace_period 2s
}

:6173 {
	encode gzip
	root * /srv

	handle /api/* {
		# flush_interval -1 disables buffering so SSE (/api/events) streams live.
		reverse_proxy 127.0.0.1:4317 {
			flush_interval -1
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
